# Neon — pooled connection (the "-pooler" host), used by the app
DATABASE_URL=
# Neon — direct connection, used by Prisma migrations
DIRECT_URL=

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public base URL, embedded in QR codes and share links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info
